{
  "name": "squishy-launcher",
  "productName": "Squishy Launcher",
  "version": "1.2.0",
  "description": "Squishy Launcher - Minecraft launcher with Modrinth mod search",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir"
  },
  "author": "Squishy",
  "license": "MIT",
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9",
    "gsap": "^3.12.5",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.squishy.launcher",
    "productName": "Squishy Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "core/**",
      "ui/**",
      "resources/**",
      "node_modules/**",
      "package.json",
      "!**/tools/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Squishy Launcher",
      "artifactName": "SquishyLauncher-Setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "Camells1",
      "repo": "squishy-launcher"
    }
  },
  "repository": "github:Camells1/squishy-launcher"
}